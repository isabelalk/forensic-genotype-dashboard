# Development Environment Variables
# Copy this to .env in backend/ directory if needed

# Backend Configuration
BACKEND_PORT=3002
UPLOAD_DIR=uploads
ARTIFACT_DIR=artifacts
MAX_UPLOAD_SIZE=104857600

# CORS (allow frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data paths (relative to backend/app unless absolute)
HIRISPLEX_MARKERS_PATH=data/hrisplexs_id.txt
PLEX34_MARKERS_PATH=data/plex34_id.txt
PLEX34_STRUCTURE_POPULATION_PATH=data/plex34_structure/metapop_3202samples.csv
PLEX34_STRUCTURE_MAINPARAMS_PATH=data/plex34_structure/mainparams
PLEX34_STRUCTURE_EXTRAPARAMS_PATH=data/plex34_structure/extraparams
