# Development Environment Variables
# Copy this to .env in backend/ directory if needed

# Backend Configuration
BACKEND_PORT=3002
APP_ENV=development
# Empty = /api is open locally. Set the same value in the Vite dev server's
# BACKEND_SHARED_SECRET to exercise the proxy check during development.
API_SHARED_SECRET=

# CORS (allow frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload storage (relative to backend/app unless absolute)
UPLOAD_DIR=uploads
ARTIFACT_DIR=artifacts
MAX_UPLOAD_SIZE=20971520
MAX_UNCOMPRESSED_UPLOAD_SIZE=104857600
MAX_UPLOAD_DIR_BYTES=1073741824
UPLOAD_IDLE_TTL_SECONDS=300
UPLOAD_MAX_AGE_SECONDS=1800

# Data paths (relative to backend/app unless absolute)
HIRISPLEX_MARKERS_PATH=data/hrisplexs_id.txt
PLEX34_MARKERS_PATH=data/plex34_id.txt
PLEX34_STRUCTURE_POPULATION_PATH=data/plex34_structure/metapop_3202samples.csv
PLEX34_STRUCTURE_MAINPARAMS_PATH=data/plex34_structure/mainparams
PLEX34_STRUCTURE_EXTRAPARAMS_PATH=data/plex34_structure/extraparams
