# Backend Configuration
BACKEND_PORT=3002
# "development" serves /docs, /redoc and /openapi.json; anything else hides them
APP_ENV=development
# When set, every /api/* request must carry X-Internal-Token with this value.
# Leave empty for local development without the proxy.
API_SHARED_SECRET=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload storage (relative to backend/app unless absolute)
UPLOAD_DIR=uploads
ARTIFACT_DIR=artifacts
MAX_UPLOAD_SIZE=20971520               # 20 MiB per file
MAX_UNCOMPRESSED_UPLOAD_SIZE=104857600 # 100 MiB after gzip expansion
MAX_UPLOAD_DIR_BYTES=1073741824        # 1 GiB total
UPLOAD_IDLE_TTL_SECONDS=300            # delete 5 minutes after last use
UPLOAD_MAX_AGE_SECONDS=1800            # delete 30 minutes after upload regardless
SWEEP_INTERVAL_SECONDS=60

# VCF shape limits (checked at upload)
MAX_VCF_SAMPLES=5000
MAX_VCF_VARIANTS=10000
MAX_VCF_CELLS=2000000

# Heavy processing
MAX_CONCURRENT_HEAVY_JOBS=2

# STRUCTURE artifacts
MAX_ARTIFACT_AGE_SECONDS=1800
MAX_ARTIFACT_COUNT=100
MAX_ARTIFACT_DIR_BYTES=536870912       # 512 MiB total
MAX_STRUCTURE_INPUT_BYTES=52428800     # 50 MiB per artifact

# Results readers
MAX_RESULTS_UPLOAD_BYTES=5242880       # 5 MiB
MAX_RESULTS_ROWS=10000
MAX_STRUCTURE_OUTPUT_LINES=10000
MAX_STRUCTURE_CLUSTERS=64

# Data paths (relative to backend/app unless absolute)
HIRISPLEX_MARKERS_PATH=data/hrisplexs_id.txt
PLEX34_MARKERS_PATH=data/plex34_id.txt
PLEX34_STRUCTURE_POPULATION_PATH=data/plex34_structure/metapop_3202samples.csv
PLEX34_STRUCTURE_MAINPARAMS_PATH=data/plex34_structure/mainparams
PLEX34_STRUCTURE_EXTRAPARAMS_PATH=data/plex34_structure/extraparams
