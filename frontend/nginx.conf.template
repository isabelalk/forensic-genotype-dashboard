# Rendered by the nginx-unprivileged image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf, which nginx includes inside its http {} block.
# Environment variables substituted at container start:
#   BACKEND_SHARED_SECRET  value sent to the backend as X-Internal-Token
#   TRUSTED_PROXY_CIDR     address range of the reverse proxy (Caddy) allowed
#                          to set X-Forwarded-For

# Per-client-IP rate and connection limits (http context).
limit_req_zone $binary_remote_addr zone=api_heavy:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api_general:10m rate=60r/m;
limit_conn_zone $binary_remote_addr zone=api_conn:10m;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Real client IP: trust X-Forwarded-For only from the reverse proxy.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Reject rate-limited / over-limit clients with 429 instead of 503.
    limit_req_status 429;
    limit_conn_status 429;

    # Default body cap; API locations below raise it where needed.
    client_max_body_size 1m;
    client_body_timeout 30s;
    client_header_timeout 30s;

    # Security headers. Do not add add_header inside locations: a location with
    # its own add_header stops inheriting these.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/xml+rss application/json;

    # Serve static files (SPA fallback)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Interactive API docs are development-only. The SPA fallback would answer
    # these paths with index.html and a 200, so refuse them explicitly.
    location ~ ^/(docs|redoc|openapi\.json)(/.*)?$ {
        return 404;
    }

    # --- API locations -------------------------------------------------------
    # nginx has no macros, so the proxy directives are repeated per location.
    # proxy_set_header X-Internal-Token replaces any client-sent value.
    # X-Forwarded-For is set to the resolved client IP (not appended to a
    # client-supplied chain), so the backend never sees a spoofed list.

    # VCF upload: 20m body, heavy rate limit
    location = /api/vcf/upload {
        client_max_body_size 20m;
        limit_req zone=api_heavy burst=5 nodelay;
        limit_conn api_conn 5;

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Internal-Token "${BACKEND_SHARED_SECRET}";
    }

    # HIrisPlex-S results reader: 5m body, heavy rate limit
    location = /api/results/hirisplex-s {
        client_max_body_size 5m;
        limit_req zone=api_heavy burst=5 nodelay;
        limit_conn api_conn 5;

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Internal-Token "${BACKEND_SHARED_SECRET}";
    }

    # STRUCTURE output reader: 5m body, heavy rate limit
    location = /api/vcf/plex34/structure-output {
        client_max_body_size 5m;
        limit_req zone=api_heavy burst=5 nodelay;
        limit_conn api_conn 5;

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Internal-Token "${BACKEND_SHARED_SECRET}";
    }

    # All other API routes: 1m body (server default), general rate limit
    location /api/ {
        limit_req zone=api_general burst=20 nodelay;
        limit_conn api_conn 5;

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Internal-Token "${BACKEND_SHARED_SECRET}";
    }
}
